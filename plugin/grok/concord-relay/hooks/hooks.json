{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "concord inbox register --provider grok", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox drain --provider grok --format post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord inbox drain --provider grok --format stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
